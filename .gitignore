# .gitignore

# Local config — never commit
.env
.env.*
*.local
*.local.*
config.py
.media/

# Claude Code per-machine state (paths, allow-lists)
.claude/

# MSAL token cache produced by first interactive auth
.msal_cache.json

# Python build / cache artifacts
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
venv/

# Editor / OS noise
.idea/
.vscode/
.spyproject/
.DS_Store
Thumbs.db
desktop.ini
*.swp
